# Copy to .env and replace all passwords with independent random values.
DATABASE_PASSWORD=replace_with_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_another_random_password
REDIS_PASSWORD=replace_with_random_redis_password
# The public overlay exposes only the web port for http://SERVER_IP:8088.
COMPOSE_FILE=docker-compose.yml:deploy/compose.public.yml
WEB_PORT=8088
SECURE_COOKIES=false
STORAGE_BACKEND=local
# For a separately provisioned private MinIO-compatible service:
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=cloudnest
# 生产默认关闭公开注册，先用本机维护命令创建账号
REGISTRATION_OPEN=false
