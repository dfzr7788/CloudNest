# /etc/cloudnest/backup.env, root:root 0600; used by both backup and updater services.
CLOUDNEST_BACKUP_MODE=split
CLOUDNEST_B_BACKUP_HOST=cloudnest-b-backup
CLOUDNEST_B_INTERNAL_ENDPOINT=http://10.77.0.2:3900
# A's metadata repository; must be outside A/B's failure domain.
RESTIC_REPOSITORY=sftp:independent-backup:/backups/cloudnest-a
RESTIC_PASSWORD_FILE=/etc/cloudnest/restic-password
