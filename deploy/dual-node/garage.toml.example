metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"
replication_factor = 1
rpc_bind_addr = "127.0.0.1:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "REPLACE_WITH_64_HEX_CHARACTERS"

[s3_api]
s3_region = "garage"
# B's WireGuard address; the interface must exist before Garage starts.
api_bind_addr = "10.77.0.2:3900"
root_domain = ".objects.example.com"
advertise_endpoint = "https://objects.example.com"

# No public website or admin API listener.
